# Copie este arquivo para local-secrets.properties (arquivo ignorado pelo git)
# e preencha com seus valores locais.

JWT_SECRET=change-me
DB_PASSWORD=change-me
ABACATEPAY_API_KEY=change-me
ABACATEPAY_WEBHOOK_SECRET=change-me
MELHOR_ENVIO_CLIENT_ID=change-me
MELHOR_ENVIO_CLIENT_SECRET=change-me
MELHOR_ENVIO_REDIRECT_URI=http://localhost:8080/shipping/oauth/callback
MELHOR_ENVIO_USER_AGENT=Nexus Store (suporte@nexusstore.local)
MELHOR_ENVIO_BASE_URL=https://sandbox.melhorenvio.com.br
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-app-password
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
AUTH_PASSWORD_RESET_FRONTEND_URL=http://localhost:3000
AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
AUTH_PASSWORD_RESET_MAIL_FROM=seu-email@gmail.com
AUTH_PASSWORD_RESET_REQUIRE_EMAIL=true
AUTH_PASSWORD_RESET_LOG_TOKEN=false
